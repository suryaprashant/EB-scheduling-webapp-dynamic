# Local API bind settings. Set HOST=0.0.0.0 on a backend host.
HOST=127.0.0.1
PORT=8000

# Set this to the exact frontend origin when deploying.
CORS_ALLOWED_ORIGIN=*

# Solver settings.
SCHEDULE_TIME_LIMIT_SECONDS=600
SCHEDULE_MIP_GAP=0.0001

# Optional; defaults to backend/.cache/schedule-result.json.
# SCHEDULE_CACHE_FILE=
